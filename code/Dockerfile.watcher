FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY dist/ ./dist/
COPY watcher/watcher.ts ./

# Create placeholder state files (will be volume-persisted on Fly.io)
RUN touch watcher-state.json watcher-dedup.json

RUN addgroup -S liberty && adduser -S liberty -G liberty
USER liberty

ENV NODE_ENV=production
ENV PORT=8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:8080/health || exit 1

CMD ["node", "dist/watcher/watcher.js"]

