{
  "name": "libertytorch",
  "version": "1.0.0",
  "description": "LibertyTorch smart contracts + watcher",
  "main": "dist/index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.ts --network",
    "watcher:build": "tsc -p watcher.tsconfig.json",
    "watcher:dev": "ts-node watcher/watcher.ts",
    "watcher:start": "node dist/watcher/watcher.js",
    "build": "npm run compile && npm run watcher:build"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@types/node": "^26.6.5",
    "hardhat": "^2.29.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "axios": "^1.20.0",
    "ethers": "^6.17.0"
  }
}
